# Copy to .env and restrict its permissions before entering credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# The published web port is bound to the Docker host's loopback interface.
AUCTION_HTTP_PORT=8080

# Enable polling only when no other process consumes this bot's updates.
# Telegram requires a public HTTPS URL for the Mini App button.
AUCTION_BOT_POLL=0
AUCTION_APP_URL=

# Optional public Git commit embedded as build metadata, never a credential.
AUCTION_SOURCE_COMMIT=
